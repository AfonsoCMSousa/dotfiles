#!/usr/bin/env python3
"""Put a PNG read from stdin on the CLIPBOARD, e.g. `maim -s | clip-png`.

Replaces `xclip -selection clipboard -t image/png`: xclip 0.13 hangs when
serving images over ~1 MB (X's chunked INCR transfer), so pasting a real
screenshot froze whatever app you pasted into. GTK handles large transfers.

Detaches and keeps serving the image until something else is copied, then
exits. Also offers the image as jpeg/bmp/tiff for apps that want those.
"""

import os
import sys

data = sys.stdin.buffer.read()
if not data:  # e.g. maim -s cancelled with Esc: leave the clipboard alone
    sys.exit(1)

# Return right away so the calling pipeline (an i3 keybinding) finishes.
if os.fork():
    sys.exit(0)
os.setsid()
devnull = os.open(os.devnull, os.O_RDWR)
for fd in (0, 1, 2):
    os.dup2(devnull, fd)

# Imported after the fork: GTK opens the X connection on import.
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")  # or `import Gdk` picks Gdk 4, clashing with Gtk 3
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GdkX11", "3.0")
from gi.repository import Gdk, GdkPixbuf, GdkX11, Gtk  # noqa: E402, F401

loader = GdkPixbuf.PixbufLoader()
loader.write(data)
loader.close()

clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
clipboard.set_image(loader.get_pixbuf())


def owner_xid():
    # GDK wraps foreign owners in window objects too, so compare X IDs
    owner = Gdk.selection_owner_get(Gdk.SELECTION_CLIPBOARD)
    return owner.get_xid() if owner else None


ours = owner_xid()


def on_owner_change(_clipboard, _event):
    # Also fires for our own set_image; quit once another client owns it.
    if owner_xid() != ours:
        Gtk.main_quit()


clipboard.connect("owner-change", on_owner_change)
Gtk.main()
